ENV=dev
# Azure SQL (ODBC Driver 17 instalado en Windows; en Docker usar Driver 18)
DATABASE_URL=mssql+pyodbc://USUARIO:PASSWORD@sql-bancocloud-utp.database.windows.net:1433/bancocloud-dev?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXP_MINUTES=30
# AES-256-GCM y HMAC-SHA256, 32 bytes en base64 cada una, DISTINTAS entre si. Generar con:
# python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
TARJETA_CLAVE_CIFRADO=
TARJETA_CLAVE_HMAC=
