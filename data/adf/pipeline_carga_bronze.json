{
  "activities": [
    {
      "name": "Copiar_transaccion",
      "type": "Copy",
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": {
            "value": "@concat('SELECT transaccion_id, cuenta_origen_id, cuenta_destino_id, fecha_hora, tipo, monto, canal, estado, concepto, transaccion_origen_id FROM transaccion WHERE fecha_hora >= ''', pipeline().parameters.fecha, ''' AND fecha_hora < DATEADD(day,1,''', pipeline().parameters.fecha, ''')')",
            "type": "Expression"
          }
        },
        "sink": {
          "type": "ParquetSink",
          "storeSettings": {
            "type": "AzureBlobFSWriteSettings"
          }
        }
      },
      "inputs": [
        {
          "referenceName": "ds_oltp_query",
          "type": "DatasetReference"
        }
      ],
      "outputs": [
        {
          "referenceName": "ds_bronze_parquet",
          "type": "DatasetReference",
          "parameters": {
            "tabla": "transaccion",
            "fecha": "@pipeline().parameters.fecha"
          }
        }
      ]
    },
