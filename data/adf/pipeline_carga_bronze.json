    {
      "name": "Copiar_movimiento_contable",
      "type": "Copy",
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": {
            "value": "@concat('SELECT m.movimiento_id, m.asiento_id, m.cuenta_contable_id, m.cuenta_cliente_id, m.tipo_movimiento, m.importe, m.moneda, cc.codigo AS codigo_cuenta_contable, a.fecha_contable, a.tipo_operacion, a.transaccion_id FROM movimiento_contable m JOIN cuenta_contable cc ON cc.cuenta_contable_id = m.cuenta_contable_id JOIN asiento_contable a ON a.asiento_id = m.asiento_id WHERE cc.codigo IN (''4101'',''4201'',''5101'',''5201'') AND a.fecha_contable = ''', pipeline().parameters.fecha, '''')",
            "type": "Expression"
          }
        },
        "sink": {
          "type": "ParquetSink",
          "storeSettings": {
            "type": "AzureBlobFSWriteSettings"
          }
        }
      },
      "inputs": [
        {
          "referenceName": "ds_oltp_query",
          "type": "DatasetReference"
        }
      ],
      "outputs": [
        {
          "referenceName": "ds_bronze_parquet",
          "type": "DatasetReference",
          "parameters": {
            "tabla": "movimiento_contable",
            "fecha": "@pipeline().parameters.fecha"
          }
        }
      ]
    }
  ],
  "parameters": {
    "fecha": {
      "type": "string"
    }
  }
